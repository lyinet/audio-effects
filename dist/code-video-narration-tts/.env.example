# ---- Provider 密钥（至少一个；auto 优先顺序：Qwen → Gemini → Seed）----

# 阿里云 DashScope / 百炼（Qwen TTS）
DASHSCOPE_API_KEY=
# 可选：国际站改为 https://dashscope-intl.aliyuncs.com/api/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_TTS_MODEL=qwen3-tts-flash

# Google Gemini TTS
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # 与 GEMINI_API_KEY 二选一
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# 火山 / BytePlus Seed Audio（openspeech）
BYTEPLUS_SEED_API_KEY=
# VOLC_TTS_API_KEY=
SEED_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/create
SEED_TTS_MODEL=seed-audio-1.0
